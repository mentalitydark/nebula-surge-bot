{
  "name": "nebula-surge-bot",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "check": "tsc --noEmit && echo ✔ Ok",
    "build": "tsc",
    "dev": "tsx --env-file=.env.dev ./src/index.ts",
    "watch": "tsx watch --include \"./src/**/*.ts\" --env-file=.env.dev ./src/index.ts",
    "start": "node --env-file=.env ./build/index.js",
    "typeorm": "tsx --env-file=.env.dev ./node_modules/typeorm/cli.js",
    "typeorm:up": "tsx --env-file=.env.dev ./node_modules/typeorm/cli.js migration:run -d ./src/infrastructure/typeorm/index.ts",
    "typeorm:down": "tsx --env-file=.env.dev ./node_modules/typeorm/cli.js migration:revert -d ./src/infrastructure/typeorm/index.ts",
    "test": "node --env-file=.env.test --import tsx --test --test-reporter @nomicfoundation/hardhat-node-test-reporter --test-reporter-destination stdout --test-concurrency=1 'src/**/*.test.ts'",
    "test:github": "node --env-file=.env.test --import tsx --test --test-reporter @nomicfoundation/hardhat-node-test-reporter --test-reporter-destination stdout --test-reporter node-test-github-reporter --test-reporter-destination stdout --test-concurrency=1 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@constatic/base": "latest",
    "@magicyan/discord": "1.7.0",
    "chalk": "5.6.2",
    "cli-color": "^2.0.4",
    "discord.js": "14.25.1",
    "reflect-metadata": "^0.2.2",
    "rou3": "0.7.10",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.28",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-node-test-reporter": "^3.0.2",
    "@types/cli-color": "^2.0.6",
    "@types/node": "^22.16.4",
    "node-test-github-reporter": "^1.3.1",
    "tsx": "4.19.3",
    "typescript": "5.9.3"
  },
  "imports": {
    "#env": [
      "./build/env.js"
    ],
    "#base": [
      "./build/discord/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ],
    "#database": [
      "./build/database/index.js"
    ],
    "#server": [
      "./build/server/index.js"
    ],
    "#menus": [
      "./build/menus/index.js"
    ],
    "#tools": [
      "./build/tools/index.js"
    ],
    "#lib/*": [
      "./build/lib/*"
    ],
    "#shared/*": [
      "./build/shared/*"
    ],
    "#entities": [
      "./build/domain/entities/index.js"
    ],
    "#errors": [
      "./build/domain/errors/index.js"
    ],
    "#repositories": [
      "./build/infrastructure/repositories/index.js"
    ],
    "#domain/*": [
      "./build/domain/*"
    ],
    "#application/*": [
      "./build/application/*"
    ],
    "#typeorm": [
      "./build/infrastructure/typeorm/index.js"
    ],
    "#infrastructure/*": [
      "./build/infrastructure/*"
    ],
    "#mocks/*": [
      "./src/__mocks__/*"
    ]
  },
  "baseVersion": "1.5.5"
}